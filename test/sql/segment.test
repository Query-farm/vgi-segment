# --------------------------------------------------------------------- read-only

# Every request the worker made was a GET (the replay server answers 405 otherwise).
query I
SELECT count(*) FROM read_json('{SEGMENT_FIXTURE_URL}/__requests') WHERE status = 405;
----
0
